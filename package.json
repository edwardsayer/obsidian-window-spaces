{
	"name": "window-spaces",
	"version": "1.1.0",
	"description": "Save and restore window layouts for popout windows. Seamlessly manage multi-window popout workspaces.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"watch": "node esbuild.config.mjs",
		"build": "tsc --noEmit && node esbuild.config.mjs production",
		"lint": "eslint src --ext .ts",
		"format": "prettier --write src/**/*.ts",
		"check": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:build": "node src/tools/test-build.js",
		"install:vault": "node src/tools/install.js",
		"deploy": "node scripts/deploy.mjs",
		"obsidian:debug": "node src/tools/obsidian-debug.js",
		"probe": "node .agents/skills/obsidian-runtime-inspection/scripts/probe.mjs",
		"extract-asar": "node .agents/skills/obsidian-internals/scripts/extract-asar.mjs",
		"new-log": "node .agents/skills/obsidian-session-log/scripts/new-log.mjs",
		"orca-send": "node .agents/skills/orca-collaboration/scripts/orca-send.mjs"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"popout-window",
		"workspace",
		"window-layout"
	],
	"author": "edwardsayer",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^25.5.0",
		"@typescript-eslint/eslint-plugin": "^7.18.0",
		"@typescript-eslint/parser": "^7.18.0",
		"builtin-modules": "^3.3.0",
		"esbuild": "^0.27.4",
		"eslint": "^8.57.0",
		"jsdom": "^24.1.3",
		"obsidian": "^1.12.3",
		"prettier": "^3.3.3",
		"tslib": "^2.8.1",
		"typescript": "^7.0.2",
		"typescript-legacy-parser": "npm:typescript@5.9.3",
		"vitest": "^1.6.0"
	}
}
