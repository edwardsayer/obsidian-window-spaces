{
	"name": "obsidian-window-spaces",
	"version": "1.0.1",
	"description": "Save and restore window layouts for Obsidian popout windows. Seamlessly manage multi-window popout workspaces.",
	"main": "main.js",
	"scripts": {
		"dev": "node src/tools/dev.js",
		"watch": "rollup -c src/tools/rollup.config.js -w",
		"build": "rollup -c src/tools/rollup.config.js",
		"lint": "eslint src --ext .ts",
		"format": "prettier --write src/**/*.ts",
		"check": "node src/tools/check-project.js",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:build": "node src/tools/test-build.js",
		"install:vault": "node src/tools/install.js"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"popout-window",
		"workspace",
		"window-layout"
	],
	"author": "edwardsayer",
	"license": "MIT",
	"devDependencies": {
		"@rollup/plugin-commonjs": "^15.0.0",
		"@rollup/plugin-node-resolve": "^9.0.0",
		"@rollup/plugin-typescript": "^6.0.0",
		"@types/node": "^14.15.0",
		"@typescript-eslint/eslint-plugin": "^4.33.0",
		"@typescript-eslint/parser": "^4.33.0",
		"eslint": "^7.32.0",
		"jsdom": "^29.1.1",
		"obsidian": "latest",
		"prettier": "^2.3.0",
		"rollup": "^2.32.0",
		"tslib": "^2.0.0",
		"typescript": "^4.0.0",
		"vitest": "^4.1.10"
	}
}
