{
  "root": true,
  "env": {
    "browser": true,
    "es2020": true,
    "node": true
  },
  "globals": {
    "activeWindow": "readonly",
    "activeDocument": "readonly",
    "NodeJS": "readonly"
  },
  "parser": "./scripts/eslint-parser.cjs",
  "parserOptions": {
    "ecmaVersion": 2020,
    "sourceType": "module",
    "project": "./tsconfig.json"
  },
  "plugins": ["@typescript-eslint"],
  "extends": ["eslint:recommended"],
  "ignorePatterns": [
    "main.js",
    "main.js.map",
    "node_modules/",
    "src/tools/*.js",
    "src/tools/*.mjs",
    "scripts/*.cjs",
    "scripts/*.mjs"
  ],
  "rules": {
    "no-unused-vars": "off",
    "@typescript-eslint/no-unused-vars": [
      "warn",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ],
    "@typescript-eslint/no-unsafe-return": "error",
    "@typescript-eslint/no-unnecessary-type-assertion": "error",
    "no-restricted-properties": [
      "error",
      {
        "object": "navigator",
        "property": "clipboard",
        "message": "Community Store 審核會把任何剪貼簿存取（即使僅寫入）列為 Behavior 通報項。請改用原生等價功能，不要使用 navigator.clipboard。"
      }
    ],
    "@typescript-eslint/no-explicit-any": "off"
  }
}
